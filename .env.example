# ── GCS / block cache ─────────────────────────────────────────────────────────
GCS_BUCKET=mf-storage-prod                 # GCS bucket name
GCS_CACHE_DIR=/tmp/gcs_cache               # Local block cache directory
GCS_CACHE_EXPIRY=604800                    # Cache expiry in seconds (default 1 week)

# ── Crucible API ──────────────────────────────────────────────────────────────
CRUCIBLE_API_KEY=                        # Crucible API key

# ── OIDC / ORCID authentication ───────────────────────────────────────────────
ORCID_CLIENT_ID=                         # ORCID OAuth app client ID
ORCID_CLIENT_SECRET=                     # ORCID OAuth app client secret
PYOIDC_SECRET=                           # Random secret key for flask-pyoidc session signing

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
OIDC_REDIRECT_URI="http://127.0.0.1:8000/redirect_uri"

# ── LLM / Vertex AI ───────────────────────────────────────────────────────────
# Auth uses Google Application Default Credentials (ADC).
# Locally: run `gcloud auth application-default login` or impersonate the service account (see README).
VERTEX_PROJECT_ID=mf-crucible            # GCP project that has Vertex AI enabled
VERTEX_REGION=us-central1               # Vertex AI region
CHAT_MODEL=gemini-2.5-pro                # Model name passed to pydantic-ai GoogleModel (optional; this is the default)
GOOGLE_APPLICATION_CREDENTIALS=.secret/graph-explorer-sa-key.json
